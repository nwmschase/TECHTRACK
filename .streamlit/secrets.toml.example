# Copy the names you need into Streamlit Cloud ? App settings ? Secrets.
# Do not commit real keys. .streamlit/secrets.toml is gitignored.
# The same names work as environment variables.

# AI keys. Guided Diagnostics uses xAI only. The story and plate reader fall back to Groq.
XAI_API_KEY = ""
GROQ_API_KEY = ""

# The model is set in code (gd_llm.DEFAULT_XAI_MODEL, grok-4.3). XAI_MODEL is no longer read.

# Optional. Default is https://api.x.ai/v1
# XAI_BASE_URL = "https://api.x.ai/v1"

# Optional. Which provider the story / plate reader tries first: xai (default) or groq.
# GD_LLM_PRIMARY = "xai"

# Optional plate-photo overrides. grok-4.3 already accepts images.
# XAI_VISION_MODEL = ""
# GROQ_VISION_MODEL = ""

# Existing app secrets (not part of the LLM switch). See DEPLOY.txt.
# AUTH_COOKIE_SECRET = ""
# R2_ENDPOINT_URL = ""
# R2_ACCESS_KEY_ID = ""
# R2_SECRET_ACCESS_KEY = ""
# R2_BUCKET_NAME = ""
